#include<stdio.h>
#define size 10
int top=-1, stack[size];

int isfull() {
  if(top==size-1)
    return 1;
   else
    return 0;
}


void push(){
  if(isfull()){
    printf("overflow\n");
    return ;

} else {
    int value;
    scanf("%d",&value);
    top=top+1;
    stack[top]=value;
    printf("the pushed value %d\n",stack[top]);} }


  int isempty() {
  if(top==-1)
    return 1;
   else
    return 0;


}void pop(){
  if(isempty()){
    printf("Underflow\n");
    return ;
} else {
    int value=stack[top];
    top=top-1;   
    printf("the poped value %d\n",value);}}


int peek()   {
  if(isempty()){
    printf("underflow\n");
    return -1;
  } else{
    return stack[top];
  } }

    void display(){      
        printf("the stack\n");
        for(int i=0;i<=top;i++){
          printf("%d\n",stack[i]);
        }
      }
    
 
int main() {
    int choice=1; 
      printf("1.push 2.pop 3.isfull 4.isempty 5.peek 6.display\n");
    while(choice<=6){
   printf("Enter choice: ");
        scanf("%d",&choice);
        switch(choice)
        {        case 1:
    push();
    break;
       case 2:
    pop();
    break;
       case 3:
    isfull()
          
    break;
       case 4:
    isempty()          
    break;
       case 5: 
        printf("Peeked value: %d\n", peek());
    break;
       case 6:
    display();
    break;
      default :
        printf("invalid\n");
      break;
    }}}
    
