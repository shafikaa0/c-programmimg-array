#include<stdio.h>
#include<stdlib.h>
#define size 100
void enqueue() ;
void dequeue() ;
void display();
int inp_arr[size],front=-1,rear=-1;
int main() {
    int choice;
    while(1){
    printf("1.enqueue 2.dequeue 3.display 4.end\n");
    printf("enter the choice\n");
    scanf("%d",&choice);
    
        switch(choice){
            case 1:
            enqueue() ;
            break;
             case 2:
            dequeue() ;
            break;
             case 3:
            display() ;
            break;
             case 4:
            exit(0) ;
            default:
            printf("invalid"); break;
        }

    }

}

void enqueue() {
    int x;
    if(rear==size-1)
    printf("overflow\n");
    else {
    if(front==-1)
    front=0;
    printf("enter the element to insert\n");
    scanf("%d",&x);
    rear=rear+1;
    inp_arr[rear]=x;
     }

}

void dequeue() {
    if(front==-1 || front>rear)
    printf("underflow\n");
    else
    
    printf("dequeued %d\n",inp_arr[front]);
    front=front+1;

}

void display() {
    if(front==-1)
    printf("empty Q\n");
    else
    printf("the Queue\n");
    for(int i=front;i<=rear;i++){
        printf("%d\n",inp_arr[i]);
    }
}
