#include <stdio.h>
int main() {
    int a[8];

    printf("Enter the 8 sorted elements of the array:\n");
    for (int i = 0; i < 8; i++) {
        scanf("%d", &a[i]);
    }

    int key;
    printf("Enter the number you want to search: ");
    scanf("%d", &key);

   int prime=1;
   if(key<=1){
       prime=0;
   }
else{
    for(int i=2;i*i<=key;i++){
        if(key%2==0){
            prime=0;
            return 0;
        }
    }
}
if(prime==0||key<50){
    printf("Not both prime and greater than 50");
    return 0;
}
    int left = 0;
    int right = 7;
    int result = -1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (a[mid] == key) {
            result = mid;
            break;        }
        else if (a[mid] < key) {
            left = mid + 1;        }
        else {
            right = mid - 1;
        }    }
    if (result != -1) {
        printf("Element found at index %d\n", result);
    } else {
        printf("Element not found\n");    }
    return 0;}
